# MailTrace Environment Configuration Template
# Problem Statement 106 — Smart India Hackathon 2026

# Backend Service Config
APP_ENV=production
DEBUG=false
SECRET_KEY=change_this_to_a_secure_32_character_random_string_in_production
DATABASE_URL=sqlite+aiosqlite:///./mailtrace.db

# API Host & Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Redis & Background Queue (Optional)
REDIS_URL=redis://localhost:6379/0

# Intelligence Provider API Keys (Optional External Services)
IPINFO_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=

# File Storage Config
UPLOAD_STORAGE_PATH=./evidence_store
MAX_UPLOAD_SIZE_BYTES=10485760 # 10 MB
